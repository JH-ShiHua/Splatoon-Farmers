{
  "name": "splatoon-farmers",
  "version": "1.0.0",
  "description": "Board-resident ESP32-S3 material farming controller with a Web Serial console.",
  "private": true,
  "license": "GPL-3.0-only",
  "type": "module",
  "scripts": {
    "test": "npm run test:firmware && npm run test:web",
    "test:firmware": "c++ -std=c++17 -Wall -Wextra -Werror -pedantic -I firmware/include firmware/src/MacroEngine.cpp tests/firmware/test_macro_engine.cpp -o /tmp/splatoon-farmers-macro-test && /tmp/splatoon-farmers-macro-test",
    "test:web": "node --test tests/web/*.test.mjs tests/data/*.test.mjs",
    "serve": "python3 -m http.server 4173 --directory web"
  }
}
